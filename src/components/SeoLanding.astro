---
import type { SeoPage } from "../data/seoPages";
import { seoPageBySlug } from "../data/seoPages";
import ContactForm from "./ContactForm.jsx";

interface Props {
  page: SeoPage;
}

const { page } = Astro.props;
---

<main>
  <header class="pt-[92px] sm:pt-[104px] bg-[#e9e8d8] overflow-hidden">
    <div class="swiss-container border-x-2 border-black px-0">
      <div class="speed-lines border-b-[3px] border-black p-4 sm:p-8 md:p-10 lg:p-14">
        <nav aria-label="Migas de pan" class="mb-6 sm:mb-10 font-mono text-[9px] sm:text-[10px] font-bold uppercase tracking-widest">
          <a href="/" class="underline decoration-2 underline-offset-4 hover:text-zt-primary">Inicio</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">{page.navLabel}</span>
        </nav>
        <span class="zine-label !bg-zt-primary">{page.eyebrow}</span>
        <h1 class="mt-5 sm:mt-7 max-w-[16ch] font-display text-3xl sm:text-5xl uppercase leading-[0.86] tracking-[-0.065em] md:text-7xl lg:text-8xl break-words">
          {page.h1}
        </h1>
        <p class="mt-6 sm:mt-9 max-w-3xl border-l-4 border-black pl-4 sm:pl-5 text-base sm:text-lg font-medium leading-relaxed md:text-xl">
          {page.intro}
        </p>
      </div>
    </div>
  </header>

  {page.sections.map((section, sectionIndex) => (
    <section class:list={["swiss-section", sectionIndex % 2 === 0 ? "bg-[#e9e8d8]" : "bg-[#d3d2bf]"]}>
      <div class="swiss-container">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="fade-up lg:col-span-5">
            <span class="zine-label">{String(sectionIndex + 1).padStart(2, "0")} / Detalle</span>
            <h2 class="mt-5 sm:mt-6 font-display text-3xl sm:text-4xl uppercase leading-[0.88] tracking-[-0.06em] md:text-6xl break-words">{section.heading}</h2>
            <p class="mt-4 sm:mt-6 max-w-xl text-sm sm:text-base font-medium leading-relaxed md:text-lg">{section.intro}</p>
          </div>
          <div class:list={[
            "grid grid-cols-1 border-l-[3px] border-t-[3px] border-black lg:col-span-7 lg:grid-cols-1",
            section.cards.length === 4 ? "sm:grid-cols-2" : "md:grid-cols-3",
          ]}>
            {section.cards.map((card, cardIndex) => (
              <article class="min-h-40 sm:min-h-44 border-b-[3px] border-r-[3px] border-black bg-[#f8f8ef] p-4 sm:p-5 fade-up md:p-6">
                <span class="font-display text-2xl sm:text-3xl text-zt-primary">{String(cardIndex + 1).padStart(2, "0")}</span>
                <h3 class="mt-5 sm:mt-7 font-display text-xl sm:text-2xl uppercase leading-none tracking-[-0.05em] break-words">{card.title}</h3>
                <p class="mt-2.5 sm:mt-3 text-xs sm:text-sm font-medium leading-relaxed text-black/70">{card.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  {page.showContactForm && (
    <section class="swiss-section bg-[#d3d2bf]" aria-labelledby="formulario-contacto">
      <div class="swiss-container grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <span class="zine-label !bg-zt-primary">Solicitud</span>
          <h2 id="formulario-contacto" class="mt-5 sm:mt-6 font-display text-3xl sm:text-4xl uppercase leading-[0.86] tracking-[-0.06em] md:text-6xl break-words">Cuéntanos el problema</h2>
          <p class="mt-4 sm:mt-5 font-mono text-xs font-bold uppercase leading-relaxed tracking-wider">Chimbote, Perú<br />Respuesta estimada / 24 h</p>
        </div>
        <div class="lg:col-span-8">
          <ContactForm client:visible />
        </div>
      </div>
    </section>
  )}

  <section class="swiss-section bg-black text-white" aria-labelledby="rutas-relacionadas">
    <div class="swiss-container">
      <h2 id="rutas-relacionadas" class="font-display text-2xl sm:text-3xl uppercase tracking-[-0.05em] md:text-5xl">Continúa explorando</h2>
      <div class="mt-6 sm:mt-8 grid grid-cols-1 border-l-2 border-t-2 border-white sm:grid-cols-3">
        {page.related.map((slug) => {
          const relatedPage = seoPageBySlug[slug];
          return (
            <a href={`/${slug}/`} class="flex min-h-20 sm:min-h-28 items-center justify-between border-b-2 border-r-2 border-white p-4 sm:p-5 font-mono text-xs font-bold uppercase tracking-wider hover:bg-zt-primary transition-colors">
              <span>{relatedPage.navLabel}</span><span aria-hidden="true">↗</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</main>
