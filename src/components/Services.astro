---
const services = [
  { num: "01", title: "Sistemas & ERPs", href: "/desarrollo-de-software/", desc: "Software a medida para operaciones, inventarios, ventas y datos empresariales.", tags: ["Backend", "Datos", "APIs"] },
  { num: "02", title: "E-Commerce", href: "/paginas-web/", desc: "Tiendas de alto rendimiento diseñadas para reducir fricción y aumentar conversión.", tags: ["Commerce", "Pagos", "CRO"] },
  { num: "03", title: "Web & Landing", href: "/paginas-web/", desc: "Sitios que comunican autoridad, capturan demanda y cargan con precisión.", tags: ["UX/UI", "SEO", "Motion"] },
  { num: "04", title: "Apps móviles", href: "/aplicaciones-moviles/", desc: "Experiencias iOS y Android conectadas a servicios y datos en tiempo real.", tags: ["iOS", "Android", "Cloud"] },
  { num: "05", title: "Dashboards", href: "/desarrollo-de-software/", desc: "Paneles operativos con indicadores claros para tomar mejores decisiones.", tags: ["KPI", "Analytics", "Realtime"] },
  { num: "06", title: "Automatización", href: "/automatizacion-de-procesos/", desc: "Integraciones que conectan herramientas y eliminan tareas repetitivas.", tags: ["APIs", "Webhooks", "Flujos"] },
];
---

<section id="servicios" class="swiss-section bg-[#e9e8d8] overflow-hidden">
  <div class="swiss-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 sm:gap-y-10 mb-10 sm:mb-16">
      <div class="lg:col-span-8 fade-up">
        <div class="swiss-kicker">01 / Capacidades</div>
        <h2 class="swiss-heading">Diseñamos el sistema. <span class="swiss-accent">Construimos el resultado.</span></h2>
      </div>
      <div class="lg:col-span-4 lg:self-end fade-up">
        <div class="zine-panel p-4 bg-[#d3d2bf] md:rotate-1">
          <span class="font-mono text-[9px] font-bold uppercase tracking-widest">Brief / 002</span>
          <p class="mt-2 text-sm leading-relaxed">Estrategia, experiencia y tecnología integradas en una sola entrega.</p>
        </div>
      </div>
    </div>

    <div class="border-t-[3px] border-x-[3px] border-black">
      {services.map((service) => (
        <article class="group grid grid-cols-12 border-b-[3px] border-black lg:min-h-36 bg-[#e9e8d8] hover:bg-black hover:text-white transition-colors fade-up">
          <div class="col-span-2 sm:col-span-2 lg:col-span-1 p-3 sm:p-4 lg:p-5 border-r-2 border-black group-hover:border-white flex items-center justify-center lg:items-start lg:justify-start font-display text-2xl sm:text-3xl xl:text-5xl text-zt-primary">
            {service.num}
          </div>
          <div class="col-span-10 sm:col-span-10 lg:col-span-4 p-3.5 sm:p-5 lg:p-6 lg:border-r-2 border-black group-hover:border-white flex flex-col justify-center lg:justify-end min-w-0">
            <h3 class="font-display text-xl sm:text-2xl xl:text-4xl uppercase tracking-[-0.055em] leading-none break-words">
              <a href={service.href} class="underline decoration-2 underline-offset-4">{service.title}</a>
            </h3>
          </div>
          <div class="col-span-12 sm:col-span-7 lg:col-span-4 p-3.5 sm:p-5 lg:p-6 border-t-2 lg:border-t-0 sm:border-r-2 border-black group-hover:border-white flex items-center text-sm md:text-base font-medium leading-relaxed">
            {service.desc}
          </div>
          <div class="col-span-12 sm:col-span-5 lg:col-span-3 p-3.5 sm:p-5 lg:p-6 border-t-2 lg:border-t-0 border-black group-hover:border-white flex flex-wrap content-center gap-1.5 sm:gap-2">
            {service.tags.map((tag) => <span class="border-2 border-current px-2 py-1 font-mono text-[8px] uppercase tracking-widest">#{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
