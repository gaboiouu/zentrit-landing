---
import { Image } from "astro:assets";
import heroImg from "../assets/img1.png";
---

<section class="pt-[92px] sm:pt-[104px] min-h-screen bg-[#e9e8d8] overflow-hidden">
  <div class="swiss-container grid grid-cols-1 lg:grid-cols-12 border-x-2 border-black min-h-[calc(100vh-104px)]">
    <div class="lg:col-span-7 min-w-0 overflow-hidden relative p-4 sm:p-7 md:p-9 lg:p-12 border-b-2 lg:border-b-0 lg:border-r-2 border-black flex flex-col justify-between speed-lines">
      <div class="ink-splatter -right-20 -top-20 opacity-30 hidden md:block"></div>
      <div class="relative z-10">
        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 mb-6 sm:mb-8">
          <span class="zine-label">A&amp;A / ZT-001</span>
          <span class="stamp text-zt-primary">Estudio digital</span>
        </div>

        <div class="relative">
          <h1 class="swiss-display hero-display hero-display--seo relative z-10 break-words">
            Zentrit: <span class="swiss-accent">desarrollo de software</span> y soluciones digitales en Perú
          </h1>
        </div>
      </div>

      <div class="relative z-10 grid grid-cols-1 md:grid-cols-7 gap-5 sm:gap-6 mt-10 sm:mt-14 pt-5 border-t-[3px] border-black">
        <p class="md:col-span-4 text-sm sm:text-base md:text-lg font-medium leading-relaxed bg-[#e9e8d8]">
          Zentrit es una empresa peruana que desarrolla software, páginas web, aplicaciones móviles y automatizaciones para empresas.
        </p>
        <div class="md:col-span-3 flex flex-col sm:flex-row md:flex-col gap-3">
          <a href="#contacto" class="swiss-button swiss-button--primary flex-1 justify-between">
            <span>Iniciar proyecto</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="#proyectos" class="swiss-button swiss-button--secondary flex-1 justify-between">
            <span>Ver archivo</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>

    <div class="lg:col-span-5 relative min-h-[22rem] sm:min-h-[28rem] lg:min-h-full bg-black overflow-hidden">
      <div class="absolute inset-4 sm:inset-6 md:inset-7 border-2 border-white z-20 pointer-events-none"></div>
      <div class="absolute inset-0 halftone">
        <Image
          src={heroImg}
          alt="Equipo de desarrollo trabajando en una solución digital"
          widths={[480, 768, 1080]}
          sizes="(max-width: 1023px) 100vw, 42vw"
          format="webp"
          quality={74}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover grayscale contrast-150 brightness-90"
        />
      </div>
      <div class="absolute inset-0 bg-zt-primary mix-blend-multiply opacity-30"></div>
      <div class="absolute top-0 right-0 z-30 bg-[#e9e8d8] text-black border-l-2 border-b-2 border-black px-3 sm:px-4 py-2 sm:py-3">
        <span class="font-mono text-[8px] uppercase tracking-widest">Development</span>
      </div>
      <div class="absolute left-0 top-1/4 sm:top-1/3 z-30 bg-white text-black border-y-2 border-r-2 border-black p-2.5 sm:p-3 -rotate-2">
        <span class="font-display text-lg sm:text-2xl uppercase leading-none block">Make it<br />work.</span>
      </div>
      <div class="absolute bottom-0 inset-x-0 z-30 grid grid-cols-3 bg-black text-white border-t-2 border-white">
        <div class="p-2.5 sm:p-4 border-r border-white/50">
          <span class="block font-mono text-[7px] sm:text-[8px] text-white/55 uppercase">Focus</span>
          <strong class="block mt-0.5 sm:mt-1 text-xs sm:text-sm">UX/UI</strong>
        </div>
        <div class="p-2.5 sm:p-4 border-r border-white/50">
          <span class="block font-mono text-[7px] sm:text-[8px] text-white/55 uppercase">Build</span>
          <strong class="block mt-0.5 sm:mt-1 text-xs sm:text-sm">Code</strong>
        </div>
        <div class="p-2.5 sm:p-4">
          <span class="block font-mono text-[7px] sm:text-[8px] text-white/55 uppercase">Scale</span>
          <strong class="block mt-0.5 sm:mt-1 text-xs sm:text-sm">Systems</strong>
        </div>
      </div>
    </div>
  </div>
</section>
