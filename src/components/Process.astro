---
const steps = [
  { num: "01", title: "Descubrir", desc: "Negocio, objetivos, usuarios y restricciones." },
  { num: "02", title: "Definir", desc: "Arquitectura, alcance y prioridades verificables." },
  { num: "03", title: "Prototipar", desc: "Flujos y experiencia validados antes del código." },
  { num: "04", title: "Construir", desc: "Desarrollo iterativo con entregas frecuentes." },
  { num: "05", title: "Escalar", desc: "Lanzamiento, medición y mejora continua." },
];
---

<section id="proceso" class="swiss-section bg-[#d3d2bf] speed-lines">
  <div class="swiss-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 sm:gap-y-10 mb-10 sm:mb-14">
      <div class="lg:col-span-8 fade-up">
        <div class="swiss-kicker">03 / Proceso</div>
        <h2 class="swiss-heading">De idea a producto, <span class="swiss-accent">sin perder el orden.</span></h2>
      </div>
      <div class="lg:col-span-4 lg:self-end">
        <div class="zine-panel p-4 bg-[#e9e8d8] md:-rotate-1">
          <span class="zine-label">Sequence</span>
          <p class="mt-3 text-sm font-medium">Cinco cuadros. Un proceso visible. Cero misterio.</p>
        </div>
      </div>
    </div>

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 border-t-[3px] border-l-[3px] border-black bg-[#e9e8d8]">
      {steps.map((step, index) => (
        <li
          class:list={[
            "relative min-h-44 sm:min-h-56 lg:min-h-72 p-4 sm:p-5 border-r-[3px] border-b-[3px] border-black flex flex-col justify-between overflow-hidden fade-up",
            index === 4 ? "sm:col-span-2 lg:col-span-1" : "",
            index === 2 ? "bg-zt-primary text-white" : "hover:bg-black hover:text-white transition-colors",
          ]}
        >
          <span class="relative z-10 font-display text-5xl sm:text-6xl xl:text-7xl tracking-[-0.08em]">{step.num}</span>
          <div class="relative z-10 mt-6">
            <h3 class="font-display text-xl xl:text-2xl uppercase tracking-[-0.05em] mb-1.5 sm:mb-2 break-words">{step.title}</h3>
            <p class="text-xs sm:text-sm font-medium leading-relaxed opacity-75">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
