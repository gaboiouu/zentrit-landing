---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import ProjectsCarousel from "../components/ProjectsCarousel.astro";
import Process from "../components/Process.astro";
import AboutUs from "../components/AboutUs.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.jsx";
import WhatsAppButton from "../components/WhatsAppButton.jsx";
---

<MainLayout>
  <Navbar />
  <main>
    <Hero />
    <Services />
    <ProjectsCarousel />
    <Process />
    <AboutUs />
    <Faq />

    <section id="contacto" class="swiss-section !py-0 bg-[#d3d2bf] overflow-hidden">
      <div class="swiss-container grid grid-cols-1 lg:grid-cols-12 border-x-[3px] border-black">
        <div class="lg:col-span-5 relative bg-black text-white p-5 sm:p-8 md:p-10 lg:border-r-[3px] border-b-[3px] lg:border-b-0 border-black flex flex-col justify-between min-h-[24rem] sm:min-h-[30rem] lg:min-h-[38rem] fade-up overflow-hidden halftone">
          <div class="ink-splatter -right-8 top-24 opacity-35 invert"></div>
          <div>
            <span class="zine-label !bg-zt-primary">06 / Contacto</span>
            <h2 class="relative z-10 mt-6 sm:mt-8 font-display text-4xl sm:text-5xl md:text-7xl uppercase tracking-[-0.07em] leading-[0.82]">Hagamos<br />algo<br /><span class="text-zt-mint">útil.</span></h2>
          </div>
          <div class="relative z-10 grid grid-cols-2 gap-3 sm:gap-4 items-end mt-8 sm:mt-12 border-2 border-white p-2.5 sm:p-3 bg-black">
            <img src="/zenti.webp" alt="Zenti, asistente de Zentrit" width="500" height="500" loading="lazy" decoding="async" class="zenti-mascot w-full max-w-44 sm:max-w-56 object-contain bg-[#e9e8d8]" />
            <div class="font-mono text-[8px] sm:text-[9px] uppercase tracking-widest leading-relaxed text-white/65">
              Chimbote, Perú<br />
              Respuesta / 24h
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 p-4 sm:p-8 md:p-10 lg:p-12 speed-lines fade-up">
          <div class="max-w-2xl">
            <div class="zine-label mb-4 sm:mb-5">Solicitud de proyecto</div>
            <p class="font-display text-2xl sm:text-3xl md:text-5xl uppercase tracking-[-0.06em] leading-[0.88] mb-7 sm:mb-10">Cuéntanos el problema. <span class="text-zt-primary">Nosotros ordenamos el resto.</span></p>
            <ContactForm client:visible />
          </div>
        </div>
      </div>
    </section>
  </main>
  <WhatsAppButton />
  <Footer />
</MainLayout>
